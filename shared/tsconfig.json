{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"rootDir": "src",
		"outDir": ".tsbuild",
		"tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
		"lib": [
			"ES2022",
			"DOM"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
