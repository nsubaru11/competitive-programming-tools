# 依存パッケージ（各ワークスペースの node_modules を全階層で無視）
node_modules/

# ビルド成果物（CLI 実行ファイル。bin/ 内の *.sh は追跡するので exe だけ個別指定）
/local-runner/bin/atcoder-cli-runner.exe

# 利用者ごとの設定と、以前の形式から書き換えたときの控え
/local-runner.settings.json
/local-runner.settings.json.bak

# 型検査の生成物（プロジェクト参照の出力と YAML の型定義）
.tsbuild/
*.d.yaml.ts

# ログ・一時ファイル（万一リポジトリ内に出力された場合の保険）
*.log
*.tmp

# OS / エディタの雑多ファイル
.DS_Store
Thumbs.db

/.idea
/.claude
*.iml

# サイトごとの秘密情報
.atcoder/
.aoj/
.codeforces/
.icpc/
.env
.env.*
session.txt
