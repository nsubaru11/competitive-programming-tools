{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"bun-types"
		],
		"noImplicitThis": false
	},
	"include": [
		"**/src/**/*.ts",
		"types/**/*.d.ts",
		"scripts/**/*.ts",
		"build.ts"
	],
	"exclude": [
		"CpToolkit",
		"node_modules"
	]
}
