{
	"server": {
		"port": 8080,
		"backend": "wsl",
		"autoStart": true,
		"startTimeoutMs": 60000,
		"extraOrigins": []
	},
	"run": {
		"timeoutMs": 10000,
		"compileTimeoutMs": 30000,
		"outputLimitMb": 2
	},
	"languages": {
		"java": {
			"family": "java",
			"name": "Java",
			"command": "java",
			"release": 24,
			"libraryLast": [],
			"stackMb": 256
		},
		"cpp": {
			"family": "cpp",
			"name": "C++",
			"submit": "C++23 (GCC",
			"command": "g++",
			"sourceFile": "Main.cpp",
			"compile": [
				"{command}",
				"-std=gnu++23",
				"-O2",
				"-march=native",
				"-DATCODER",
				"-DNOMINMAX",
				"-DONLINE_JUDGE",
				"-fconstexpr-depth=1024",
				"-fconstexpr-loop-limit=524288",
				"-fconstexpr-ops-limit=2097152",
				"-fmodules",
				"-ftrivial-auto-var-init=zero",
				"-pthread",
				"-fopenmp",
				"-Wall",
				"-Wextra",
				"{source}",
				"-o",
				"{output}",
				"-Wl,--as-needed",
				"-lstdc++exp"
			],
			"run": [
				"{output}"
			],
			"debugArgs": [
				"-DLOCAL"
			],
			"setup": "builtin:gcc-header-unit",
			"stackMb": 1024
		},
		"c": {
			"family": "c",
			"name": "C",
			"submit": "C23 (GCC",
			"command": "gcc",
			"sourceFile": "Main.c",
			"compile": [
				"{command}",
				"-std=c23",
				"-O2",
				"-march=native",
				"-DATCODER",
				"-DONLINE_JUDGE",
				"-Wall",
				"-Wextra",
				"{source}",
				"-o",
				"{output}",
				"-lm"
			],
			"run": [
				"{output}"
			],
			"debugArgs": [
				"-DLOCAL"
			],
			"stackMb": 1024
		},
		"cpython": {
			"family": "python3",
			"name": "Python (CPython)",
			"match": [
				"CPython"
			],
			"submit": "Python (CPython",
			"command": "python3",
			"sourceFile": "Main.py",
			"compile": [
				"{command}",
				"-m",
				"py_compile",
				"{source}"
			],
			"run": [
				"{command}",
				"-X",
				"int_max_str_digits=0",
				"{source}"
			],
			"debugRewrite": true,
			"stackMb": 1024
		},
		"pypy": {
			"family": "python3",
			"name": "Python (PyPy)",
			"match": [
				"PyPy"
			],
			"submit": "Python (PyPy",
			"command": "pypy3",
			"sourceFile": "Main.py",
			"compile": [
				"{command}",
				"-m",
				"py_compile",
				"{source}"
			],
			"run": [
				"{command}",
				"-X",
				"int_max_str_digits=0",
				"{source}"
			],
			"debugRewrite": true,
			"stackMb": 1024
		},
		"codon": {
			"family": "python3",
			"name": "Python (Codon)",
			"match": [
				"Codon"
			],
			"submit": "Python (Codon",
			"command": "codon",
			"sourceFile": "Main.py",
			"compile": [
				"{command}",
				"build",
				"--release",
				"-o",
				"{output}",
				"{source}"
			],
			"run": [
				"{output}"
			],
			"debugRewrite": true,
			"stackMb": 1024
		},
		"go": {
			"family": "go",
			"name": "Go",
			"submit": "Go (go",
			"command": "go",
			"sourceFile": "main.go",
			"compile": [
				"{command}",
				"build",
				"-o",
				"{output}",
				"{source}"
			],
			"run": [
				"{output}"
			],
			"stackMb": 1024
		},
		"rust": {
			"family": "rust",
			"name": "Rust",
			"submit": "Rust (rustc",
			"command": "rustc",
			"sourceFile": "main.rs",
			"compile": [
				"{command}",
				"--edition",
				"2024",
				"-O",
				"{source}",
				"-o",
				"{output}"
			],
			"run": [
				"{output}"
			],
			"stackMb": 1024
		},
		"kotlin": {
			"family": "kotlin",
			"name": "Kotlin",
			"submit": "Kotlin (Kotlin/JVM",
			"command": "kotlinc",
			"sourceFile": "Main.kt",
			"compile": [
				"{command}",
				"{source}",
				"-include-runtime",
				"-d",
				"Main.jar"
			],
			"run": [
				"java",
				"-Xss256m",
				"-jar",
				"Main.jar"
			],
			"stackMb": 1024
		},
		"csharp": {
			"family": "csharp",
			"name": "C#",
			"submit": "C# 13.0 (.NET 9",
			"command": "dotnet",
			"sourceFile": "Main.cs",
			"compile": [
				"{command}",
				"build",
				"{source}",
				"-c",
				"Release",
				"-o",
				"out",
				"--nologo",
				"-v",
				"q"
			],
			"run": [
				"{command}",
				"out/Main.dll"
			],
			"stackMb": 1024
		}
	},
	"extensions": {
		".java": "java",
		".cpp": "cpp",
		".c": "c",
		".py": "cpython",
		".go": "go",
		".rs": "rust",
		".kt": "kotlin",
		".cs": "csharp"
	},
	"headers": {},
	"atcoder": {
		"sessionFile": "~/.atcoder/session.txt",
		"sampleCache": true,
		"resultWaitMs": 300000
	}
}
