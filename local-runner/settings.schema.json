{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Local Runner の設定",
	"description": "変えたい項目だけを書く。書かなかった項目は既定値で動く。",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"server": {
			"description": "サーバーの起動と接続。変更したら stop のあと serve で反映する。",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"port": {
					"description": "サーバーのポート。CLI の接続先もここから決まる。",
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"default": 8080
				},
				"backend": {
					"description": "Windows でサーバーを動かす場所。wsl は WSL の中、native は Windows の Bun と JDK。",
					"enum": [
						"wsl",
						"native"
					],
					"default": "wsl"
				},
				"autoStart": {
					"description": "サーバーが動いていないとき、test などのコマンドが自動で起動する。",
					"type": "boolean",
					"default": true
				},
				"startTimeoutMs": {
					"description": "自動で起動したサーバーの準備を待つ時間(ms)。",
					"type": "integer",
					"minimum": 1000,
					"default": 60000
				},
				"extraOrigins": {
					"description": "対応するジャッジサイトのほかに、ブラウザからの要求を許すオリジン(例: http://localhost:4173)。",
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^https?://[^/]+$"
					},
					"default": []
				}
			}
		},
		"run": {
			"description": "実行の制限。変更したら stop のあと serve で反映する。",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"timeoutMs": {
					"description": "1回の実行を打ち切る時間(ms)。",
					"type": "integer",
					"minimum": 100,
					"default": 10000
				},
				"compileTimeoutMs": {
					"description": "コンパイルと提出用の変換を打ち切る時間(ms)。",
					"type": "integer",
					"minimum": 1000,
					"default": 30000
				},
				"outputLimitMb": {
					"description": "標準出力と標準エラー出力のそれぞれについて、取り込む量の上限(MB)。",
					"type": "integer",
					"minimum": 1,
					"maximum": 64,
					"default": 2
				}
			}
		},
		"languages": {
			"description": "言語ごとの実行環境。変更したら stop のあと serve で反映する。",
			"type": "object",
			"additionalProperties": {
				"description": "コンパイルと実行をコマンドで行う言語。既定の言語は書いた項目だけを上書きし、新しい名前を書けば言語を足せる。",
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"enabled": {
						"description": "false にすると、この言語を使わない。",
						"type": "boolean",
						"default": true
					},
					"family": {
						"description": "言語の種類。CP Toolkit は、ページの言語と同じ種類の実行環境を候補にする。",
						"enum": [
							"cpp",
							"csharp",
							"c",
							"python2",
							"python3",
							"java",
							"javascript",
							"typescript",
							"kotlin",
							"rust",
							"go",
							"ruby",
							"haskell",
							"d",
							"scala",
							"swift",
							"php",
							"perl",
							"bash",
							"lua",
							"nim",
							"ocaml",
							"crystal",
							"julia",
							"elixir",
							"erlang",
							"clojure",
							"fsharp",
							"scheme",
							"lisp",
							"pascal",
							"fortran",
							"cobol",
							"objective-c",
							"basic",
							"dart",
							"zig",
							"r",
							"awk",
							"sed",
							"fish",
							"powershell",
							"raku",
							"sagemath",
							"octave",
							"prolog",
							"ada",
							"lean",
							"text"
						]
					},
					"name": {
						"description": "表示に使う名前。",
						"type": "string",
						"minLength": 1
					},
					"match": {
						"description": "ページの言語の表記にこの語が含まれていれば、同じ種類の中でこの実行環境を先頭にする(例: PyPy)。大文字と小文字は区別しない。",
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"submit": {
						"description": "AtCoder の提出フォームの言語名に含まれる文字列。たとえば「C++23 (GCC」と書く。submit がこの言語で提出する。大文字と小文字は区別しない。",
						"type": "string",
						"minLength": 1
					},
					"command": {
						"description": "処理系の命令。名前だけなら PATH から探す。パスなら、サーバーが動く側(WSL)のパスで書く。",
						"type": "string",
						"minLength": 1
					},
					"sourceFile": {
						"description": "作業フォルダへ書き出すソースのファイル名(例: Main.cpp)。",
						"type": "string",
						"pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
					},
					"compile": {
						"description": "コンパイルの引数の並び。{command}、{source}、{output}、{dir} が置き換わる。空の並びならコンパイルしない。",
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"run": {
						"description": "実行の引数の並び。{command}、{source}、{output}、{dir} が置き換わる。",
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"debugArgs": {
						"description": "デバッグが有効なとき、compile の末尾に足す引数(例: -DLOCAL)。",
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"debugRewrite": {
						"description": "true にすると、ソースの DEBUG = true をデバッグの有無に合わせて書き換える。提出物では false にする。",
						"type": "boolean",
						"default": false
					},
					"stackMb": {
						"description": "スタックの上限(MB)。",
						"type": "integer",
						"minimum": 1,
						"maximum": 4096,
						"default": 1024
					},
					"setup": {
						"description": "組み込みの準備。builtin:gcc-header-unit は、bits/stdc++.h を読んだ結果を保存してコンパイルを速くする。g++ と -fmodules が要る。",
						"enum": [
							"builtin:gcc-header-unit"
						]
					},
					"bundle": {
						"description": "コンパイルの前と提出物の作成で通す変換のコマンド。ソースを標準入力で受け、変換したソースを標準出力へ返す。",
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			},
			"properties": {
				"java": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"family": {
							"description": "言語の種類。CP Toolkit は、ページの言語と同じ種類の実行環境を候補にする。",
							"enum": [
								"cpp",
								"csharp",
								"c",
								"python2",
								"python3",
								"java",
								"javascript",
								"typescript",
								"kotlin",
								"rust",
								"go",
								"ruby",
								"haskell",
								"d",
								"scala",
								"swift",
								"php",
								"perl",
								"bash",
								"lua",
								"nim",
								"ocaml",
								"crystal",
								"julia",
								"elixir",
								"erlang",
								"clojure",
								"fsharp",
								"scheme",
								"lisp",
								"pascal",
								"fortran",
								"cobol",
								"objective-c",
								"basic",
								"dart",
								"zig",
								"r",
								"awk",
								"sed",
								"fish",
								"powershell",
								"raku",
								"sagemath",
								"octave",
								"prolog",
								"ada",
								"lean",
								"text"
							]
						},
						"name": {
							"description": "表示に使う名前。",
							"type": "string",
							"minLength": 1
						},
						"match": {
							"description": "ページの言語の表記にこの語が含まれていれば、同じ種類の中でこの実行環境を先頭にする(例: PyPy)。大文字と小文字は区別しない。",
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							}
						},
						"command": {
							"description": "java の命令。名前だけなら PATH から探し、javac も PATH から探す。パスなら同じフォルダの javac を使う。",
							"type": "string",
							"minLength": 1,
							"default": "java"
						},
						"release": {
							"description": "提出先の Java のバージョン。JDK の方が新しいときは javac の --release で揃える。",
							"type": "integer",
							"minimum": 8,
							"default": 24
						},
						"library": {
							"description": "lib フォルダを持つ、Java のライブラリの src フォルダ。書かなければライブラリなしで動く。",
							"type": "string",
							"minLength": 1
						},
						"stackMb": {
							"description": "解答を実行するスレッドのスタック(MB)。",
							"type": "integer",
							"minimum": 1,
							"maximum": 1024,
							"default": 256
						}
					},
					"description": "Java。常駐する JVM で動かす。"
				}
			},
			"propertyNames": {
				"pattern": "^[a-z][a-z0-9_-]*$"
			}
		},
		"extensions": {
			"description": "ソースの拡張子から言語を選ぶ対応。値は languages の名前。CLI が実行のたびに読む。",
			"type": "object",
			"propertyNames": {
				"pattern": "^\\.[a-z0-9_+-]+$"
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			}
		},
		"headers": {
			"description": "提出物の先頭に付けるファイル。キーは言語(java)か、--header=<名前> で選ぶ名前。",
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"default": {}
		},
		"atcoder": {
			"description": "AtCoder との通信。CLI が実行のたびに読む。",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"sessionFile": {
					"description": "REVEL_SESSION の値を保存したファイル。",
					"type": "string",
					"minLength": 1,
					"default": "~/.atcoder/session.txt"
				},
				"sampleCache": {
					"description": "取得したサンプルを保存して使い回す。",
					"type": "boolean",
					"default": true
				},
				"resultWaitMs": {
					"description": "提出の結果が確定するのを待つ時間(ms)。",
					"type": "integer",
					"minimum": 1000,
					"default": 300000
				}
			}
		}
	}
}
