{
	"name": "@atcoder-tools/runner",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@atcoder-tools/shared": "workspace:*"
	},
	"scripts": {
		"runner": "bun ./src/daemon/server.ts",
		"test": "bun ./src/cli/index.ts test",
		"submit": "bun ./src/cli/index.ts submit",
		"tomain": "bun ./src/cli/index.ts tomain",
		"toclip": "bun ./src/cli/index.ts toclip",
		"localtest": "bun ./src/cli/index.ts localtest",
		"serve": "bun ./src/cli/index.ts serve",
		"setlib": "bun ./src/cli/index.ts setlib",
		"setheader": "bun ./src/cli/index.ts setheader",
		"build:cli:win": "bun build --compile --target=bun-windows-x64 ./src/cli/index.ts --outfile ./bin/atcoder-cli-runner.exe",
		"build": "bun run typecheck && bun run build:cli:win",
		"package": "bun ./scripts/package.ts",
		"typecheck": "tsc --noEmit",
		"test:java": "bun ./src/cli/java.smoke.ts",
		"test:bundle": "bun run test:java",
		"test:unit": "bun test src"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
